<!--
  hbbs（ID / 信令服务器）的 WinSW 服务配置模板

  安装脚本会替换以下占位符后使用：
    {{INSTALL_DIR}}   安装目录，例如 C:\RustDeskServer
    {{RELAY_SERVER}}  中继地址（本机公网 IP 或域名），hbbs 的 -r 参数

  注意：
    - workingdirectory 决定 id_ed25519 密钥生成位置，hbbs 和 hbbr 必须一致
    - -k _ 表示"使用工作目录里的密钥"，启用后客户端必须填 Key 才能注册
-->
<service>
  <id>rustdesk-hbbs</id>
  <name>RustDesk ID Server (hbbs)</name>
  <description>RustDesk ID/信令服务器。监听 TCP 21115/21116、UDP 21116、TCP 21118。</description>

  <executable>{{INSTALL_DIR}}\hbbs.exe</executable>
  <arguments>-r {{RELAY_SERVER}} -k _</arguments>
  <workingdirectory>{{INSTALL_DIR}}</workingdirectory>

  <logpath>{{INSTALL_DIR}}\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>

  <!-- 崩溃后 10 秒自动重启；1 小时无故障则重置计数 -->
  <onfailure action="restart" delay="10 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>15 sec</stoptimeout>

  <startmode>Automatic</startmode>
  <delayedAutoStart>false</delayedAutoStart>
  <priority>Normal</priority>

  <!-- 排查连接问题时取消下面这行的注释，会打印每个 TCP 连接 -->
  <!-- <env name="RUST_LOG" value="debug"/> -->
</service>
